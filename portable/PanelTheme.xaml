<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <SolidColorBrush x:Key="PanelInk" Color="#FFF0DD" />
  <SolidColorBrush x:Key="PanelMuted" Color="#DEBBAF" />
  <SolidColorBrush x:Key="PanelLine" Color="#89565C" />
  <SolidColorBrush x:Key="PanelDivider" Color="#64414C" />
  <SolidColorBrush x:Key="PanelField" Color="#3F222D" />
  <SolidColorBrush x:Key="PanelHot" Color="#5C303D" />
  <SolidColorBrush x:Key="PanelSelected" Color="#713F4F" />
  <SolidColorBrush x:Key="PanelGold" Color="#F1C99D" />
  <SolidColorBrush x:Key="PanelOnGold" Color="#361A25" />

  <Style TargetType="{x:Type Button}">
    <Setter Property="Foreground" Value="{StaticResource PanelInk}" />
    <Setter Property="Background" Value="{StaticResource PanelField}" />
    <Setter Property="BorderBrush" Value="{StaticResource PanelLine}" />
    <Setter Property="MinHeight" Value="26" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="Padding" Value="7,2" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Button}">
          <Border x:Name="ButtonFrame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="1" CornerRadius="5" SnapsToDevicePixels="True">
            <Grid>
              <Border x:Name="Hover" Background="White" Opacity="0" CornerRadius="4" />
              <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="Center" RecognizesAccessKey="True" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Hover" Property="Opacity" Value=".1" /></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Hover" Property="Opacity" Value=".2" /></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ButtonFrame" Property="BorderBrush" Value="{StaticResource PanelGold}" /></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonFrame" Property="Opacity" Value=".52" /></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="PanelPrimary" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Background" Value="{StaticResource PanelGold}" />
    <Setter Property="Foreground" Value="{StaticResource PanelOnGold}" />
    <Setter Property="MinHeight" Value="28" />
  </Style>

  <Style TargetType="{x:Type CheckBox}">
    <Setter Property="Foreground" Value="{StaticResource PanelInk}" />
    <Setter Property="MinHeight" Value="44" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type CheckBox}">
          <Border x:Name="ToggleFrame" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="4">
            <Grid Margin="11,0">
              <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="34" /></Grid.ColumnDefinitions>
              <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True" />
              <Border x:Name="Pill" Grid.Column="1" Width="34" Height="18" VerticalAlignment="Center"
                      Background="{StaticResource PanelField}" BorderBrush="{StaticResource PanelLine}" BorderThickness="1" CornerRadius="9">
                <Ellipse x:Name="Dot" Width="12" Height="12" Fill="{StaticResource PanelMuted}"
                         HorizontalAlignment="Left" VerticalAlignment="Center" Margin="2,0" />
              </Border>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ToggleFrame" Property="Background" Value="{StaticResource PanelHot}" /></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ToggleFrame" Property="BorderBrush" Value="{StaticResource PanelGold}" /></Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Pill" Property="Background" Value="{StaticResource PanelGold}" />
              <Setter TargetName="Pill" Property="BorderBrush" Value="{StaticResource PanelGold}" />
              <Setter TargetName="Dot" Property="Fill" Value="{StaticResource PanelOnGold}" />
              <Setter TargetName="Dot" Property="HorizontalAlignment" Value="Right" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="SettingsAction" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Button}">
          <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="1" CornerRadius="20">
            <Grid>
              <Border x:Name="Hover" Background="White" Opacity="0" CornerRadius="20" />
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Hover" Property="Opacity" Value=".1" /></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Hover" Property="Opacity" Value=".2" /></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource PanelInk}" /></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="SettingsTabs" TargetType="{x:Type TabControl}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type TabControl}">
          <DockPanel>
            <Border DockPanel.Dock="Top" Margin="20,4,20,0" BorderThickness="0,0,0,1"
                    BorderBrush="{StaticResource PanelDivider}">
              <TabPanel IsItemsHost="True" KeyboardNavigation.TabNavigation="Once" />
            </Border>
            <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" Margin="20,14,20,12"
                              KeyboardNavigation.TabNavigation="Local" />
          </DockPanel>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="SettingsTab" TargetType="{x:Type TabItem}">
    <Setter Property="Foreground" Value="{StaticResource PanelInk}" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type TabItem}">
          <Grid MinWidth="90" Height="38" Background="Transparent">
            <Border x:Name="TabFocus" Margin="2,2,2,4" BorderThickness="1" BorderBrush="Transparent" CornerRadius="5" />
            <ContentPresenter ContentSource="Header" Margin="16,0" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <Border x:Name="Indicator" Height="3" VerticalAlignment="Bottom" Margin="5,0"
                    Background="{StaticResource PanelGold}" CornerRadius="2" Visibility="Hidden" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabFocus" Property="Background" Value="{StaticResource PanelField}" /></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="TabFocus" Property="BorderBrush" Value="{StaticResource PanelLine}" /></Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter Property="Foreground" Value="{StaticResource PanelGold}" />
              <Setter TargetName="Indicator" Property="Visibility" Value="Visible" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="SpringStyleSwitch" TargetType="{x:Type ToggleButton}">
    <Setter Property="Width" Value="74" />
    <Setter Property="Height" Value="24" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ToggleButton}">
          <Border x:Name="Track" Background="#582431" BorderBrush="#9C5C63" BorderThickness="1"
                  CornerRadius="11" Padding="2">
            <Grid IsHitTestVisible="False">
              <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
              </Grid.ColumnDefinitions>
              <Border x:Name="Thumb" Background="#FFD0D7" CornerRadius="8" />
              <TextBlock x:Name="Peach" Text="Đào" Foreground="#4F1C31" FontSize="10" FontWeight="SemiBold"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
              <TextBlock x:Name="Apricot" Grid.Column="1" Text="Mai" Foreground="#FFE2C0" FontSize="10"
                         FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Thumb" Property="Grid.Column" Value="1" />
              <Setter TargetName="Thumb" Property="Background" Value="#FFD578" />
              <Setter TargetName="Peach" Property="Foreground" Value="#FFDCE0" />
              <Setter TargetName="Apricot" Property="Foreground" Value="#4F1C31" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Track" Property="BorderBrush" Value="#FFF0DD" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Track" Property="BorderBrush" Value="#FFF0DD" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="HolidayRow" TargetType="{x:Type CheckBox}">
    <Setter Property="MinHeight" Value="41" />
    <Setter Property="Foreground" Value="{StaticResource PanelInk}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type CheckBox}">
          <Border Background="Transparent" BorderBrush="{StaticResource PanelDivider}" BorderThickness="0,0,0,1">
            <Border x:Name="Row" Background="Transparent" BorderBrush="Transparent" BorderThickness="1"
                    CornerRadius="5" Padding="11,3">
              <DockPanel>
                <Border x:Name="Box" Width="19" Height="19" CornerRadius="4" Margin="0,0,13,0"
                        VerticalAlignment="Center" BorderThickness="1" BorderBrush="{StaticResource PanelMuted}">
                  <Path x:Name="Mark" Data="M 1 5 L 4 8 L 10 1" Stroke="{StaticResource PanelOnGold}"
                      StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Hidden" />
                </Border>
                <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" />
              </DockPanel>
            </Border>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Row" Property="Background" Value="#4C2330" />
              <Setter TargetName="Box" Property="Background" Value="{StaticResource PanelGold}" />
              <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource PanelGold}" />
              <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Row" Property="Background" Value="{StaticResource PanelHot}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource PanelGold}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="{x:Type ComboBoxItem}">
    <Setter Property="Foreground" Value="{StaticResource PanelInk}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ComboBoxItem}">
          <Border x:Name="Choice" Background="Transparent" Padding="5,3">
            <ContentPresenter />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsSelected" Value="True"><Setter TargetName="Choice" Property="Background" Value="{StaticResource PanelSelected}" /></Trigger>
            <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Choice" Property="Background" Value="{StaticResource PanelHot}" /></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="{x:Type ComboBox}">
    <Setter Property="Foreground" Value="{StaticResource PanelInk}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="MinHeight" Value="26" />
    <Setter Property="MaxDropDownHeight" Value="155" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ComboBox}">
          <Grid>
            <ToggleButton Focusable="False" ClickMode="Press" Cursor="Hand"
                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
              <ToggleButton.Template>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                  <Border x:Name="Field" Background="{StaticResource PanelField}" BorderBrush="{StaticResource PanelLine}"
                          BorderThickness="1" CornerRadius="5" />
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Field" Property="Background" Value="{StaticResource PanelHot}" /></Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </ToggleButton.Template>
            </ToggleButton>
            <DockPanel IsHitTestVisible="False" Margin="5,0" LastChildFill="True">
              <Path DockPanel.Dock="Right" Width="7" Margin="4,0,1,0" VerticalAlignment="Center" Data="M0,0 L3.5,3.5 7,0"
                    Stroke="{StaticResource PanelGold}" StrokeThickness="1" />
              <TextBlock Text="{Binding SelectionBoxItem, RelativeSource={RelativeSource TemplatedParent}}"
                         TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            </DockPanel>
            <Border x:Name="ComboFocus" BorderBrush="Transparent" BorderThickness="1" CornerRadius="5" IsHitTestVisible="False" />
            <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" Focusable="False" AllowsTransparency="True">
              <Border Margin="0,2,0,0" Background="{StaticResource PanelField}" BorderBrush="{StaticResource PanelLine}"
                      BorderThickness="1" CornerRadius="5" Padding="2" MinWidth="{TemplateBinding ActualWidth}"
                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="True">
                  <ItemsPresenter />
                </ScrollViewer>
              </Border>
            </Popup>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="ComboFocus" Property="BorderBrush" Value="{StaticResource PanelGold}" /></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="PanelTrackSpace" TargetType="{x:Type RepeatButton}">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type RepeatButton}">
      <Border Background="Transparent" />
    </ControlTemplate></Setter.Value></Setter>
  </Style>

  <Style TargetType="{x:Type ScrollBar}">
    <Setter Property="Width" Value="9" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ScrollBar}">
          <Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}" IsDirectionReversed="True">
            <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource PanelTrackSpace}" Command="ScrollBar.PageUpCommand" /></Track.DecreaseRepeatButton>
            <Track.Thumb><Thumb MinHeight="14" Cursor="Hand"><Thumb.Template><ControlTemplate TargetType="{x:Type Thumb}">
              <Border Background="{StaticResource PanelLine}" Margin="3,0,1,0" CornerRadius="2" />
            </ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
            <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource PanelTrackSpace}" Command="ScrollBar.PageDownCommand" /></Track.IncreaseRepeatButton>
          </Track>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="{x:Type Slider}">
    <Setter Property="Height" Value="19" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Slider}">
          <Grid Background="Transparent">
            <Border x:Name="Rail" Height="3" Margin="4,0" Background="{StaticResource PanelLine}" CornerRadius="1.5" />
            <Track x:Name="PART_Track">
              <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource PanelTrackSpace}" Command="Slider.DecreaseLarge" /></Track.DecreaseRepeatButton>
              <Track.Thumb><Thumb Width="12" Height="12" Cursor="Hand"><Thumb.Template><ControlTemplate TargetType="{x:Type Thumb}">
                <Ellipse Fill="{StaticResource PanelGold}" />
              </ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
              <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource PanelTrackSpace}" Command="Slider.IncreaseLarge" /></Track.IncreaseRepeatButton>
            </Track>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Rail" Property="Background" Value="{StaticResource PanelGold}" /></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="{x:Type ListBoxItem}">
    <Setter Property="Foreground" Value="{StaticResource PanelInk}" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="ToolTip" Value="{Binding Title}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ListBoxItem}">
          <Border x:Name="Song" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="4" Padding="4,3">
            <ContentPresenter />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Song" Property="Background" Value="{StaticResource PanelHot}" /></Trigger>
            <Trigger Property="IsSelected" Value="True"><Setter TargetName="Song" Property="Background" Value="{StaticResource PanelSelected}" /></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Song" Property="BorderBrush" Value="{StaticResource PanelGold}" /></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="{x:Type ListBox}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ListBox}">
          <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5">
            <ScrollViewer Focusable="False" Padding="{TemplateBinding Padding}" PanningMode="VerticalOnly"
                          CanContentScroll="{TemplateBinding ScrollViewer.CanContentScroll}"
                          VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}"
                          HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}">
              <ItemsPresenter />
            </ScrollViewer>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <DataTemplate x:Key="PanelTrackItem">
    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
  </DataTemplate>
</ResourceDictionary>
